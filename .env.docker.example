# Copy to .env.docker and fill in local/staging values.
# Host ports. Cloud staging should override these to avoid the systemd 8084/9091.
# Backend and Actuator bind to loopback so only nginx is publicly reachable.
BACKEND_BIND=127.0.0.1
MANAGEMENT_BIND=127.0.0.1
WEB_BIND=0.0.0.0
MYSQL_BIND=127.0.0.1
MYSQL_HOST_PORT=13306
REDIS_BIND=127.0.0.1
REDIS_HOST_PORT=16379
WEB_PORT=8080
BACKEND_PORT=8084
MANAGEMENT_PORT=9091

MYSQL_DATABASE=btry_edu
DB_USER=btry
DB_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root
REDIS_PASSWORD=change-me-redis
REDIS_DATABASE=0
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUST_FORWARDED_HEADERS=true
APP_BASE_URL=http://127.0.0.1:8080
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
SAMPLE_VIDEO_KEY=edu/video/91/demo-real-181s-faststart-cache.mp4
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
ALERT_WEBHOOK_URL=
TRACING_ENABLED=false
OTLP_TRACING_ENDPOINT=http://jaeger:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# Optional observability profile
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=14318

# Optional container tuning. Values are deliberately small enough for the
# 3.7GB cloud host to run staging beside the systemd production process.
MYSQL_BUFFER_POOL_SIZE=128M
MYSQL_MEM_LIMIT=512m
REDIS_MEM_LIMIT=160m
BACKEND_MEM_LIMIT=640m
WEB_MEM_LIMIT=64m
