# 复制为 .env 后填入真实值，.env 不进 git
# ---- 数据库 ----
ETRY_DB_URL=jdbc:mysql://127.0.0.1:3306/etry
ETRY_DB_USER=
ETRY_DB_PASSWORD=

# ---- Redis ----
ETRY_REDIS_HOST=127.0.0.1
ETRY_REDIS_PORT=6379
ETRY_REDIS_PASSWORD=

# ---- JWT ----
# 至少 32 字节的随机串
ETRY_JWT_SECRET=

# ---- 腾讯云 COS ----
ETRY_COS_SECRET_ID=
ETRY_COS_SECRET_KEY=
ETRY_COS_BUCKET=rag-1325750042
ETRY_COS_REGION=ap-shanghai

# ---- 邮件（QQ 邮箱 SMTP，密码填 16 位授权码）----
ETRY_MAIL_TYPE=smtp
ETRY_MAIL_USERNAME=
ETRY_MAIL_PASSWORD=

# ---- 存储与缓存实现 ----
ETRY_STORAGE_TYPE=cos
ETRY_CACHE_TYPE=redis
