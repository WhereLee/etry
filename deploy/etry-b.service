[Unit]
Description=etry instance B (port 8082)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/etry
EnvironmentFile=/opt/etry/.env
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java -Xms128m -Xmx256m -jar /opt/etry/etry.jar --server.port=8082 --spring.profiles.active=prod
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
