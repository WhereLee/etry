<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wherelee.edu.audit.AuditMapper">

    <!-- 审计查询：按人、按动作过滤，时间倒序。索引 idx_audit_user_time / idx_audit_action_time 支撑 -->
    <sql id="pageCondition">
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="action != null and action != ''">
                AND action = #{action}
            </if>
        </where>
    </sql>

    <select id="findPage" resultType="com.wherelee.edu.audit.AuditRecord">
        SELECT id, user_id, username, action, target_type, target_id, detail, ip, success, cost_ms, created_at
        FROM t_audit_log
        <include refid="pageCondition"/>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM t_audit_log
        <include refid="pageCondition"/>
    </select>

</mapper>
