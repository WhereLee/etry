<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wherelee.edu.modules.operations.admin.AdminUserMapper">

    <sql id="userFilters">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (u.username LIKE CONCAT('%', #{keyword}, '%')
                     OR u.nickname LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="role != null and role != ''">
                AND u.role = #{role}
            </if>
            <if test="status != null and status != ''">
                AND u.status = #{status}
            </if>
        </where>
    </sql>

    <select id="findPage" resultType="com.wherelee.edu.modules.operations.admin.dto.AdminUserVO">
        SELECT u.id,
               u.username,
               u.nickname,
               u.role,
               u.status,
               u.must_change_password AS mustChangePassword,
               (SELECT COUNT(*) FROM t_student_series ss
                WHERE ss.user_id = u.id AND ss.status = 'ACTIVE') AS seriesCount,
               u.created_at AS createdAt
        FROM t_user u
        <include refid="userFilters"/>
        ORDER BY u.id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countUsers" resultType="long">
        SELECT COUNT(*)
        FROM t_user u
        <include refid="userFilters"/>
    </select>

    <select id="findAllSeries" resultType="com.wherelee.edu.modules.operations.admin.dto.SeriesOptionVO">
        SELECT id, title FROM t_series WHERE status = 'PUBLISHED' ORDER BY sort, id
    </select>
</mapper>
