<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wherelee.edu.user.UserMapper">

    <!--
      用户列表：支持关键词（用户名或昵称模糊）和状态筛选。
      分页交给 application 层算 offset，不用框架插件，SQL 一眼能看懂。
    -->
    <sql id="pageCondition">
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                <!-- ESCAPE '\\' 让用户输入的 % 和 _ 按字面意思匹配，不再当通配符 -->
                AND (username LIKE CONCAT('%', #{keyword}, '%') ESCAPE '\\'
                     OR nickname LIKE CONCAT('%', #{keyword}, '%') ESCAPE '\\')
            </if>
        </where>
    </sql>

    <select id="findPage" resultType="com.wherelee.edu.user.User">
        SELECT id, username, nickname, status, token_version, created_at, updated_at
        FROM t_user
        <include refid="pageCondition"/>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM t_user
        <include refid="pageCondition"/>
    </select>

    <!--
      群发前批量校验收件人：一次 IN 查出存在的 ID，
      不逐个 findById（发 200 人就是 200 次往返）。
    -->
    <select id="findExistingIds" resultType="long">
        SELECT id FROM t_user WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
